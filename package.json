{
  "name": "svg-editor-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1 SVG command-line editor",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p plugins/plugin-command-stats && tsc -p plugins/plugin-command-dir",
    "check": "tsc -p tsconfig.test.json",
    "cli": "tsx src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "visual:check": "node scripts/VisualAcceptance.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "workspaces": [
    "plugins/*"
  ]
}
